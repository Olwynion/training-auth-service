    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\contracts\proto\auth\auth.proto" GrpcServices="Server" Link="protos\auth.proto" ProtoRoot="..\..\proto\contracts\proto\" />
